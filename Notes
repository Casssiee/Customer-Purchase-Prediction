Task 1:Clean data
import pandas as pd

raw_customer_data = pd.read_csv('raw_customer_data.csv')
clean_data = raw_customer_data.copy()

# time_spent: float, fill missing with median
clean_data['time_spent'] = clean_data['time_spent'].fillna(clean_data['time_spent'].median()).astype(float)

# pages_viewed: integer, fill missing with mean
clean_data['pages_viewed'] = clean_data['pages_viewed'].fillna(clean_data['pages_viewed'].mean()).astype(int)

# basket_value: float, fill missing with 0
clean_data['basket_value'] = clean_data['basket_value'].fillna(0).astype(float)

# device_type: must be Mobile/Desktop/Tablet, else "Unknown"
clean_data['device_type'] = clean_data['device_type'].apply(
    lambda x: x if x in ['Mobile', 'Desktop', 'Tablet'] else 'Unknown'
)

# customer_type: must be New/Returning, else "New"
clean_data['customer_type'] = clean_data['customer_type'].apply(
    lambda x: x if x in ['New', 'Returning'] else 'New'
)

# Ensure correct dtypes
clean_data['customer_id'] = clean_data['customer_id'].astype(int)
clean_data['purchase'] = clean_data['purchase'].astype(int)

clean_data

Task 2:Prepare data for modeling
import pandas as pd
from sklearn.preprocessing import MinMaxScaler

model_data = pd.read_csv('model_data.csv')
model_feature_set = model_data.copy()

# Scale numerical features to 0-1
scaler = MinMaxScaler()
model_feature_set[['time_spent', 'pages_viewed', 'basket_value']] = scaler.fit_transform(
    model_feature_set[['time_spent', 'pages_viewed', 'basket_value']]
)

# One-hot encode categorical features
model_feature_set = pd.get_dummies(
    model_feature_set,
    columns=['device_type', 'customer_type'],
    prefix=['device_type', 'customer_type'],
    prefix_sep='_',
    dtype=int
)

model_feature_set

Task 3:Train neural network and predict
import pandas as pd
import torch
import torch.nn as nn
import torch.optim as optim

# Load data
input_model_features = pd.read_csv('input_model_features.csv')
validation_features = pd.read_csv('validation_features.csv')

# Training data
X_train = input_model_features.drop(columns=['customer_id', 'purchase'])
y_train = input_model_features['purchase']

# Validation data
val_customer_ids = validation_features['customer_id']
X_val = validation_features.drop(columns=['customer_id'])

# Convert to tensors
X_train_tensor = torch.tensor(X_train.values, dtype=torch.float32)
y_train_tensor = torch.tensor(y_train.values, dtype=torch.float32).view(-1, 1)
X_val_tensor = torch.tensor(X_val.values, dtype=torch.float32)

# Define network: hidden layer with 8 units, ReLU, sigmoid output
class PurchaseNet(nn.Module):
    def __init__(self, input_dim):
        super().__init__()
        self.fc1 = nn.Linear(input_dim, 8)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(8, 1)
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        x = self.relu(self.fc1(x))
        x = self.sigmoid(self.fc2(x))
        return x

# Initialize and train
torch.manual_seed(42)
purchase_model = PurchaseNet(X_train_tensor.shape[1])
criterion = nn.BCELoss()
optimizer = optim.Adam(purchase_model.parameters(), lr=0.01)

purchase_model.train()
for epoch in range(100):
    optimizer.zero_grad()
    outputs = purchase_model(X_train_tensor)
    loss = criterion(outputs, y_train_tensor)
    loss.backward()
    optimizer.step()

# Predict on validation set
purchase_model.eval()
with torch.no_grad():
    val_probs = purchase_model(X_val_tensor)
    val_preds = (val_probs >= 0.5).int().numpy().flatten()

# Output DataFrame
validation_predictions = pd.DataFrame({
    'customer_id': val_customer_ids.values,
    'purchase': val_preds
})

validation_predictions
